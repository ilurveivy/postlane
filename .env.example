# Postlane —— 自托管个性化冷邮件工作台
#
# 复制成 .env 后按需修改；Docker Compose 会自动读取本文件。
# 完整说明见 docs/configuration.md

# ---------- 服务 ----------
PORT=4173
# 监听地址。本机使用留空即可（默认 127.0.0.1）。
# Docker / 反向代理场景必须设为 0.0.0.0，否则发布出去的端口连不上（容器的回环网卡
# 不在端口映射路径上）。放开监听不等于放开访问，仍然由 Host 与来源校验把关。
# BIND_HOST=0.0.0.0
# 数据目录：SQLite 数据库、加密密钥、留档文件都在这里，必须持久化
DATA_DIR=./data
# 前端静态资源目录（只在 `npm start` / --production 启动时读取）
# STATIC_DIR=dist

# ---------- 访问控制 ----------
# basic = HTTP Basic 认证；off = 完全不鉴权（仅限可信内网）
POSTLANE_ACCESS_MODE=basic
# 至少 32 个字符。留空则完全不鉴权 —— 只在 localhost 上可以这样跑。
# 生成方式：openssl rand -base64 32
POSTLANE_ACCESS_PASSWORD=
# 也可以把密码放进私有文件（权限 600），二选一
# POSTLANE_ACCESS_PASSWORD_FILE=/run/secrets/postlane-password
# 可选：反向代理对外时填你的 HTTPS 域名（CSRF 来源校验 + 一键退订链接）
# 不填也能用：邮件里不带一键退订链接，退订由正文「回复退订」和 List-Unsubscribe 的 mailto 生效
# POSTLANE_PUBLIC_ORIGIN=https://mail.example.com
# true 表示允许局域网内其他设备访问（仍然只接受私网地址）
LAN_ACCESS=false

# ---------- 运行开关 ----------
# live = 正常；verify = 只读演示模式（禁止发送、同步与任何外部请求）
POSTLANE_MODE=live
# 关掉不需要的后台任务（例如只想用发送链路时）
DISABLE_MAIL_SYNC=false
DISABLE_BATCH_REPORTS=false
DISABLE_BACKUP=false
DISABLE_DELIVERY_RECOVERY=false
DISABLE_SLEEP_GUARD=false
# 填 disabled 可关闭地址预检阶段的 DNS 查询（离线环境或 DNS 不可用时用）
# PREFLIGHT_DNS=

# ---------- 发送 ----------
# 同一账号最多同时提交几封
SEND_ACCOUNT_CONCURRENCY=1
# 需要固定出口 IP 时填 HTTP 代理，形如 http://user:pass@host:port
# SMTP_PROXY=

# ---------- 报告与留档收件人 ----------
# 批次执行报告 / 12 小时核查报告发给谁。留空 = 不发送报告邮件（报告仍在界面上可看）。
# 多个地址用逗号分隔。
# POSTLANE_REPORT_TO=you@example.com
# 只想让某类报告发给不同的人时可以分别覆盖：
# POSTLANE_EXECUTION_REPORT_TO=you@example.com
# POSTLANE_AUDIT_REPORT_TO=you@example.com
# 留档副本的默认收件人（新建任务时可勾选，最多 2 个）
# POSTLANE_ARCHIVE_RECIPIENTS=you@example.com
# 属于你自己的其它地址：统计回复率时会被排除
# POSTLANE_INTERNAL_RECIPIENTS=

# ---------- 每日备份 ----------
# 打开后每天自动做一次加密快照（数据库 + 配置 + 留档）
POSTLANE_BACKUP_ENABLED=false
# 备份与恢复状态文件、备份包默认放这里
# POSTLANE_CONFIG_DIR=
# POSTLANE_BACKUP_DIR=
# 备份包额外复制到这个目录（NFS/SMB/rclone 挂载点），读回并校验 SHA-256
# POSTLANE_BACKUP_REMOTE_DIR=
# 备份失败时的告警收件人；留空则只写日志不发信
# POSTLANE_ADMIN_EMAIL=
# 备份脚本调用的 tar 可执行文件；Windows 上 tar 不在 PATH 时显式指定
# POSTLANE_TAR=C:\Windows\System32\tar.exe
